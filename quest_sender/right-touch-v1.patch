@@ -0,0 +1,28 @@
+using System.Globalization;
+using System.Text;
+using UnityEngine;
+
+// Additive protocol: the existing CTRL encoder/analog validation stays unchanged.
+public static class RightTouchPacket
+{
+    public static string Encode(LeftControllerPacket.Sample controls, bool headTracked,
+        Vector3 p, Quaternion q, Vector3 hp, Quaternion hq)
+    {
+        // Reuse the exact version/session/sequence/clock/boolean/analog contract.
+        string common = LeftControllerPacket.Encode(controls).TrimEnd('\n');
+        common = "RTOUCH" + common.Substring("CTRL".Length);
+        int analogOffset = common.IndexOf(",index=", System.StringComparison.Ordinal);
+        common = common.Insert(analogOffset, ",head_tracked=" + (headTracked ? "1" : "0"));
+        var packet = new StringBuilder(common);
+        AppendPose(packet, "", p, q);
+        AppendPose(packet, "h", hp, hq);
+        return packet.Append('\n').ToString();
+    }
+
+    private static void AppendPose(StringBuilder packet, string prefix, Vector3 p, Quaternion q)
+    {
+        packet.AppendFormat(CultureInfo.InvariantCulture,
+            ",{0}px={1:R},{0}py={2:R},{0}pz={3:R},{0}qx={4:R},{0}qy={5:R},{0}qz={6:R},{0}qw={7:R}",
+            prefix, p.x, p.y, p.z, q.x, q.y, q.z, q.w);
+    }
+}
